# Environment Mode
# NOTE: NODE_ENV=development is for local development only and must NOT be copied as a production configuration.
# In production, set NODE_ENV=production and provide explicit values for all secrets and database URLs.
NODE_ENV=development

# MongoDB Connection URL (required in non-development environments; optional only when NODE_ENV=development)
# If not set when NODE_ENV=development, defaults to: mongodb://127.0.0.1:27017/Renthouse
MONGO_URL=mongodb://127.0.0.1:27017/Renthouse

# Session Secret (required in non-development environments; optional only when NODE_ENV=development)
# If not set when NODE_ENV=development, a local development default is used. Never use defaults or predictable keys in production!
SESSION_SECRET=your-super-secret-session-key-here

# Server Port (optional, defaults to 8080)
PORT=8080
