# Environment (development or production)
NODE_ENV=development

# MongoDB Connection URL (required in production, optional in development)
# If not set in development, defaults to: mongodb://127.0.0.1:27017/Renthouse
MONGO_URL=mongodb://127.0.0.1:27017/Renthouse

# Session Secret (required in production, optional in development)
# If not set in development, a default will be used (not recommended for production)
SESSION_SECRET=your-super-secret-session-key-here

# Server Port (optional, defaults to 8080)
PORT=8080
